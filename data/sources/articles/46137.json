  "definitions": [
   {
    "elements": [
     {
      "elements": [
       {
        "content": "verbalform som uttrykker fortid i forhold til tidspunktet for utsagnet, $ ‘det snødde i går’",
        "items": [
         {
          "id": "f_eks",
          "type_": "entity"
         }
        ],
        "type_": "explanation"
       }
      ],
      "id": 2,
      "sub_definition": false,
      "type_": "definition"
     },
     {
      "elements": [
       {
        "content": "brukt i vilkårssetninger, for eksempel  ‘hvis jeg hadde mange penger’, ‘var det mulig å få litt å drikke?’",
        "items": [],
        "type_": "explanation"
       }
      ],
      "id": 3,
      "sub_definition": false,
      "type_": "definition"
     },
     {
      "elements": [
       {
        "content": "brukt i uttrykk for undring eller misnøye, for eksempel ‘det var stor gutt, det’, ‘det var dumt at du ikke kunne komme’",
        "items": [],
        "type_": "explanation"
       },
       {
        "article": {
         "article_id": 125388,
         "body": {
          "definitions": [
           {
            "elements": [
             {
              "content": "verbalform der hjelpeverbet står i preteritum og hovedverbet i perfektum partisipp, for eksempel ‘vi hadde reist’, ‘vi var reist’",
              "items": [],
              "type_": "explanation"
             }
            ],
            "id": 1,
            "sub_definition": false,
            "type_": "definition"
           }
          ]
